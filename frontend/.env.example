# Copy this file to .env.local and fill in your values.
# Never prefix secret keys with NEXT_PUBLIC_ (that sends them to the browser).

# --- Amazon Bedrock: Claude Haiku 4.5 (plant, soil and AR vision) ---
AWS_REGION=us-east-1
# Bedrock API key (Bedrock console > API keys)
AWS_BEARER_TOKEN_BEDROCK=
# Or use IAM keys instead of the API key:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional. Default: global.anthropic.claude-haiku-4-5-20251001-v1:0
# For India data residency try: apac.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID=

# --- Cerebras (plant chat) ---
CEREBRAS_API_KEY=

# --- Deepgram (voice input / output) ---
DEEPGRAM_API_KEY=

# --- Supabase (scan + chat history) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- OpenWeather (optional) ---
OPENWEATHER_API_KEY=
