# Copy this file to .env.local and fill in your values.
# Never prefix secret keys with NEXT_PUBLIC_ (that sends them to the browser).

# --- Amazon Bedrock: Claude Haiku 4.5 (plant, soil and AR vision) ---
AWS_REGION=ap-south-1
# Bedrock API key (Bedrock console > API keys)
AWS_BEARER_TOKEN_BEDROCK=
# Or use IAM keys instead of the API key:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional. Default: global.anthropic.claude-haiku-4-5-20251001-v1:0
# For India data residency try: apac.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID=

# --- Cerebras (plant chat) ---
CEREBRAS_API_KEY=

# --- Deepgram (voice input / output) ---
DEEPGRAM_API_KEY=

# --- Supabase (scan + chat history) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- OpenWeather (optional) ---
OPENWEATHER_API_KEY=

# --- Voice Doctor models ---
# Diagnosis model (default: Sonnet 4.6, best in our tomato test). Haiku 4.5 stays the fast default for other calls.
BEDROCK_DIAGNOSIS_MODEL=
# Model that names the plant in the scanner and live view (default: the diagnosis model above).
# Check it on your own photos: node --env-file=.env.local scripts/test-identify.mjs <photos> --expect=<name>
BEDROCK_ID_MODEL=
# --- Sarvam (speech to text and text to speech) ---
SARVAM_API_KEY=
